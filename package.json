{
  "name": "rtlgate",
  "version": "0.1.0",
  "description": "A local CI gate that catches Arabic/RTL layout and bidi bugs before release: CSS, markup, locale strings, runtime overflow.",
  "license": "MIT",
  "author": "Sohaib Thiab",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./fixtures/ar-corpus.json": "./fixtures/ar-corpus.json"
  },
  "bin": {
    "rtlgate": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "fixtures",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "prepare": "tsc"
  },
  "keywords": [
    "rtl",
    "arabic",
    "i18n",
    "localization",
    "bidi",
    "css-logical-properties",
    "github-action",
    "sarif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohaibt/rtlgate.git"
  },
  "homepage": "https://github.com/sohaibt/rtlgate",
  "bugs": {
    "url": "https://github.com/sohaibt/rtlgate/issues"
  },
  "engines": {
    "node": ">=18.3"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2"
  }
}
